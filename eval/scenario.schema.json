        "do": {
          "const": "advance",
          "title": "Do",
          "type": "string"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "at",
        "do",
        "seconds"
      ],
      "title": "Advance",
      "type": "object"
    },
    "BuyerMessage": {
