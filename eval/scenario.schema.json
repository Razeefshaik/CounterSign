  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "fault_class": {
      "enum": [
        "NONE",
        "TIMEOUT_AFTER_CREATE",
        "CRASH_BETWEEN_ACCEPT_AND_RECORD",
        "PENDING_PAST_RUN",
        "ONHOLD",
        "BLOCKED",
        "UNCLAIMED_CANCEL_RACE",
        "PARTIAL_BATCH_FAILURE",
        "WEBHOOK_DUPLICATE",
        "WEBHOOK_DELAYED",
        "WEBHOOK_REORDERED",
        "WEBHOOK_FORGED",
        "STALE_APPROVAL",
        "DOUBLE_SPEND_PROPOSALS",
        "RETRY_SETTLED_OBLIGATION",
        "DISPUTE_DEADLINE_CLOSE",
        "INJECTION_REFUND_OTHER_ACCOUNT",
        "INJECTION_NEW_PAYEE",
        "INSUFFICIENT_UNRESERVED_CASH",
        "UNSTRUCTURED_DISPUTE_TRIAGE",
        "KEY_WINDOW_EXPIRED"
