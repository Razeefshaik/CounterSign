# Copy to .env and fill in. Never commit .env.

# --- Runtime mode ---
# demo = local mock_paypal only (default; never reads sandbox credentials)
# live = the PayPal sandbox (needs the PayPal values below)
COUNTERSIGN_MODE=demo
DATABASE_URL=
# Bearer token for the owner approval endpoints
OWNER_TOKEN=

# --- PayPal sandbox (live mode only) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional (empty breaks startup): defaults to the mock in demo mode, the sandbox in live mode
# PAYPAL_BASE_URL=
# Recorded sandbox behaviour (D9, D10): multipart evidence, JSON accept-claim, refunds from available
PAYPAL_EVIDENCE_FORMAT=multipart
PAYPAL_ACCEPT_CLAIM_FORMAT=json
PAYPAL_REFUND_SOURCE=paypal:available

# --- Local mock (demo mode) ---
# Optional fake credentials; defaults are mock-client / mock-secret
# MOCK_PAYPAL_CLIENT_ID=
# MOCK_PAYPAL_CLIENT_SECRET=
# 1 enables the mock's /_mock control endpoints
# MOCK_CONTROL=1

# --- AI model (configured runs only; the scripted model needs none of these) ---
COUNTERSIGN_LLM_PROVIDER=google_genai
COUNTERSIGN_LLM_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
# Absolute path to the separate toolkit interpreter, e.g. <repo>\.venv\toolkit\Scripts\python.exe
# COUNTERSIGN_TOOLKIT_PYTHON=

# --- Background workers (optional; defaults shown) ---
COUNTERSIGN_INBOX_INTERVAL_SECONDS=5
COUNTERSIGN_RECONCILE_INTERVAL_SECONDS=60
COUNTERSIGN_EXECUTOR_INTERVAL_SECONDS=60
COUNTERSIGN_WORKER_MAX_PROPOSALS=100

# --- Sandbox accounts for the day-one checks (developer dashboard > Sandbox > Accounts) ---
SBX_BUYER_EMAIL=
SBX_MAKER_A_EMAIL=
SBX_MAKER_B_EMAIL=
SBX_MAKER_C_EMAIL=
# Comma separated; must NOT exist as sandbox accounts
SBX_UNREG_EMAILS=

# Tests read these from the process environment, not from .env:
# COUNTERSIGN_TEST_DATABASE_URL=postgresql://countersign:countersign-dev@127.0.0.1:55433/countersign
# COUNTERSIGN_TEST_TOOLKIT_PYTHON=<repo>\.venv\toolkit\Scripts\python.exe
