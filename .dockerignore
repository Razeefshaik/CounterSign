# Never send secrets or local state into the image build.
.env
.env.*
!.env.example
**/.env
**/.env.*
.git
.venv
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.import_linter_cache
**/*.egg-info
build
dist
# Not needed at runtime: published recordings, tests, evaluation and docs.
recordings
tests
eval
docs
web/tests
*.md
!README.md
